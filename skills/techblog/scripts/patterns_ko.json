{
  "schema": 1,
  "notes": [
    "lint_ko.py가 쓰는 정규식 패턴 정의. 사람이 편집하는 파일이다.",
    "scope: sentence(본문 문장 전체), sentence_start(문장 첫머리), para_last(문단 마지막 문장), heading(헤딩), title(H1)",
    "패턴은 따옴표 안 텍스트와 인라인 코드를 가린 문장에 적용한다.",
    "max_len이 있으면 그 글자 수 이하인 문장에만 적용한다(내용 없는 짧은 문장 판별용)."
  ],
  "patterns": {
    "G2.experience": {
      "title": "지어낸 경험 표현",
      "scope": "sentence",
      "regex": [
        "(직접|실제로)\\s*(써|사용해|운영해|적용해|돌려|테스트해|도입해)\\s*(보니|봤더니|보면서|본\\s*결과)",
        "(써|사용해|운영해|적용해)\\s*보니(까)?\\s"
      ],
      "hint": "자료를 쓴 사람의 경험이 아니면 자료를 주어로 쓴다(\"저자들은 ~를 측정했습니다\")."
    },
    "G3.chatbot": {
      "title": "챗봇 응답 흔적",
      "scope": "sentence",
      "regex": [
        "궁금한\\s*(점|부분|사항)(이|은)?\\s*(있|생기|남)",
        "^물론(입니다|이죠|이에요|이지요)",
        "요청(하신|해\\s*주신)\\s*(글|내용|대로|자료|사항)",
        "원하시면",
        "(더|추가로)\\s*(필요하시면|궁금하시면)",
        "(AI|인공지능|언어\\s*모델)(로서|인\\s*저는|인\\s*제가)",
        "제가\\s*학습한"
      ],
      "hint": "요청자에게 하는 말은 지운다. 아티클은 독자에게 쓴다."
    },
    "G3.placeholder": {
      "title": "placeholder",
      "scope": "sentence",
      "regex": [
        "\\[(링크|URL|이미지|그림|회사명|이름|출처|날짜|작성자)[^\\]]{0,20}\\]",
        "(OOO|○○○|ㅇㅇㅇ)",
        "\\((이미지|그림)\\s*(삽입|첨부)\\)"
      ],
      "hint": "자료에 있는 실제 값으로 채우거나 문장을 지운다."
    },
    "G3.source_meta": {
      "title": "자료를 가리키는 메타 표현",
      "scope": "sentence",
      "regex": [
        "(제공|첨부|공유|전달)(된|해\\s*주신|하신|받은)\\s*(자료|문서|글|파일|PDF)",
        "주어진\\s*(자료|문서|글)(에|을|를|의|에서)",
        "원문(에\\s*따르면|을\\s*바탕으로)",
        "해당\\s*자료"
      ],
      "hint": "자료의 제목, 저자, 기관을 주어로 쓴다(\"Paech 등의 Antislop 논문은\")."
    },
    "G8.beyond_simple": {
      "title": "\"단순한 X를 넘어\"",
      "scope": "sentence",
      "regex": [
        "단순(한|히)\\s+[^.?!]{0,40}?(을|를)\\s*넘어",
        "단순한\\s+[^.?!]{0,20}?그\\s*이상"
      ],
      "hint": "X를 부정하지 말고 Y를 바로 쓴다."
    },
    "G9.cliche_intro": {
      "title": "시대 일반론 도입",
      "scope": "sentence",
      "regex": [
        "오늘날[^.?!]{0,40}(빠르게|급속(도로|히)|급격(하게|히))",
        "(시대|시기)(가|이)\\s*(도래|열리|열렸|왔)",
        "점점\\s*(더\\s*)?(중요해지|주목받)",
        "(빠르게|급속도로)\\s*변화하는\\s*(환경|시대|세상)"
      ],
      "hint": "자료가 다루는 구체 상황이나 문제로 시작한다."
    },
    "G9.cliche_outro": {
      "title": "근거 없는 전망 마무리",
      "scope": "sentence",
      "regex": [
        "앞으로[^.?!]{0,25}(기대(됩니다|돼요|가\\s*됩니다|해\\s*봅니다)|주목(됩니다|돼요))",
        "무궁무진",
        "새로운\\s*(지평|장|가능성)을\\s*(열|여|제시)",
        "(미래|앞날)(가|는|이)\\s*(밝|기대)",
        "귀추가\\s*주목"
      ],
      "hint": "자료의 마지막 구체 사실이나 자료가 남긴 열린 질문으로 끝낸다."
    },
    "G9.empty_challenge": {
      "title": "내용 없는 과제 문장",
      "scope": "sentence",
      "max_len": 35,
      "regex": [
        "^(물론\\s*)?[^.?!]{0,8}(과제|숙제|한계)(도|는|가)\\s*(여전히\\s*|아직\\s*)?(남아\\s*있|분명(합|해|하)|존재(합|해))"
      ],
      "hint": "자료가 밝힌 구체 한계를 쓰거나 문장을 지운다."
    },
    "A1.np_anira": {
      "title": "X가 아니라 Y",
      "scope": "sentence",
      "regex": [
        "(이|가|게)\\s*아니라(?!고|면)"
      ],
      "hint": "부정하는 X를 지우고 Y를 바로 쓴다."
    },
    "A1.np_rather": {
      "title": "X라기보다",
      "scope": "sentence",
      "regex": [
        "(라기|하기|이기)\\s*보다(는)?\\s"
      ],
      "hint": "비교 대상을 지우고 주장만 쓴다."
    },
    "A1.np_geuchi": {
      "title": "X에 그치지 않고",
      "scope": "sentence",
      "regex": [
        "에\\s*그치지\\s*않"
      ],
      "hint": "더하는 내용을 바로 쓴다."
    },
    "A1.np_neomeo": {
      "title": "X를 넘어 Y",
      "scope": "sentence",
      "regex": [
        "(^|\\s)[^\\s\\d%]{1,20}(을|를)\\s*넘어(서)?[\\s,]"
      ],
      "hint": "수치 초과(\"1초를 넘어\")가 아니면 Y를 바로 쓴다."
    },
    "A1.np_deoisang": {
      "title": "더 이상 X가 아닌",
      "scope": "sentence",
      "regex": [
        "더\\s*이상\\s*[^.?!]{0,20}(이|가)\\s*아닌"
      ],
      "hint": "현재 상태를 바로 쓴다."
    },
    "A1.np_simple": {
      "title": "단순히 X가 아니라",
      "scope": "sentence",
      "regex": [
        "단순(히|한)\\s+[^.?!]{0,30}?(이|가|게)\\s*아니라"
      ],
      "hint": "글당 1회까지. Y를 바로 쓴다."
    },
    "A1.ppunman": {
      "title": "뿐만 아니라 (참고 지표)",
      "scope": "sentence",
      "regex": [
        "뿐(만)?\\s*아니라"
      ],
      "hint": "참고 지표. 사람 글 1,000자당 0.07회."
    },
    "A3.salience": {
      "title": "강조 문장",
      "scope": "sentence",
      "regex": [
        "(가장\\s*)?중요한\\s*(것|점|건|부분)(은|이|는)",
        "^핵심(은|이)\\s",
        "^(관건|요점)(은|이)\\s",
        "주목할\\s*(만한\\s*)?(점|것|부분|대목)",
        "눈여겨\\s*(볼|봐야\\s*할)\\s*(점|것|부분|대목)",
        "(이|이것|이게|이\\s*점|이는)\\s*(이|은|는|가)?\\s*(매우\\s*|정말\\s*|특히\\s*|무엇보다\\s*)?중요(합니다|해요|하다)",
        "(것|게)이?\\s*(매우\\s*|무엇보다\\s*|특히\\s*|가장\\s*)?중요(합니다|해요|하다)",
        "왜\\s[^.?!]{0,30}중요(할까요|한가|한지|할까)",
        "(기억해야|기억해\\s*둘|명심해야)\\s*할?\\s*(점|것)",
        "무엇보다(도)?\\s*(중요|핵심)"
      ],
      "hint": "중요하다고 말하는 대신 왜 중요한지(비용, 수치, 결과)를 쓰거나 문장을 지운다."
    },
    "A4.summary_start": {
      "title": "문단 끝 요약 표지",
      "scope": "para_last",
      "regex": [
        "^(결국|요컨대|한마디로|정리하면|정리하자면|즉|이처럼|이렇듯|다시\\s*말해|요약하면)(\\s|,)"
      ],
      "hint": "앞 문장을 되풀이하는 요약이면 지운다."
    },
    "A4.obligation_end": {
      "title": "문단 끝 당위문",
      "scope": "para_last",
      "regex": [
        "(해야|돼야|되어야|봐야|가져야|챙겨야|고려해야|확인해야|살펴봐야)\\s*(합니다|해요|한다|할\\s*것입니다|할\\s*거예요)[.?!]?$"
      ],
      "hint": "독자에게 지시하는 교훈 대신 자료의 사실로 끝낸다."
    },
    "A4.lesson_end": {
      "title": "문단 끝 교훈",
      "scope": "para_last",
      "regex": [
        "(보여\\s*줍니다|보여\\s*줘요|보여준다|일깨워\\s*줍니다|일깨워\\s*줘요|시사합니다|시사해요|말해\\s*줍니다|말해\\s*줘요|방증합니다)[.?!]?$",
        "(라는|다는)\\s*(점|사실)을\\s*(보여|기억|잊지)"
      ],
      "hint": "의미를 부여하는 문장 대신 구체 사실을 남긴다."
    },
    "A4.gyeolguk": {
      "title": "\"결국\"",
      "scope": "sentence",
      "regex": [
        "(^|\\s)결국(\\s|,)"
      ],
      "hint": "글당 1회까지."
    },
    "A5.style_words": {
      "title": "과사용 어휘",
      "scope": "sentence",
      "regex": [
        "시사(하|합|해|한|할|점|하는\\s*바)",
        "구조적(인|으로)?",
        "체계적(인|으로)?",
        "통합적(인|으로)?",
        "다층적(인|으로)?",
        "핵심적(인|으로)?",
        "실질적(인|으로)?",
        "전략적(인|으로)?",
        "혁신적(인|으로)?",
        "획기적(인|으로)?",
        "원활(하|한|히|합|해)",
        "기능(합니다|해요|한다|하는|하며|하고|할|했)",
        "규명(하|합|해|한|했|할)",
        "메커니즘",
        "기제"
      ],
      "hint": "평이한 동사(이다, 있다, 쓰다, 보이다)와 자료의 구체 표현으로 바꾼다."
    },
    "A5.policy_verbs": {
      "title": "추상 정책 동사",
      "scope": "sentence",
      "regex": [
        "(강화|확대|개선|확보|마련|구축)(하|합|해|한|할|했|되|됩|돼|된|될)"
      ],
      "hint": "무엇을 얼마나 바꿨는지 자료의 수치로 쓴다."
    },
    "A6.calque": {
      "title": "Claude 번역 표현과 상투 은유",
      "scope": "sentence",
      "regex": [
        "떠받(치|쳐|친|칠)",
        "(^|\\s)조용히\\s",
        "(두|세|네|다섯|여러|몇)\\s*(개의\\s*)?(축|갈래)(으로|로|이|가|을|를|에서|입니다|예요|이에요|가\\s*있)",
        "(봐야|챙겨야|살펴야|고민해야|들어가야)\\s*(하는|할)\\s*자리",
        "여정",
        "지평",
        "청사진",
        "발판",
        "토대(를|가|로|이|가\\s*되)",
        "초석",
        "신호탄",
        "퍼즐\\s*조각",
        "양날의\\s*검",
        "게임\\s*체인저",
        "판도를\\s*(바꾸|뒤집)",
        "빙산의\\s*일각",
        "나침반",
        "주춧돌",
        "날개를\\s*(달|단)",
        "민낯",
        "(숨은|숨겨진)\\s*(영웅|공신|주역)",
        "마법(처럼|같은|과\\s*같)"
      ],
      "hint": "비유를 지우고 대상과 수치를 직접 쓴다."
    },
    "A7.hedge_stack": {
      "title": "추정 표현 중첩",
      "scope": "sentence",
      "regex": [
        "(할|될|있을|일)\\s*수\\s*(도\\s*)?있을\\s*(것|듯)",
        "가능성이\\s*있을\\s*수",
        "(것|듯)\\s*(으로|처럼)?\\s*보일\\s*수",
        "(일|할)\\s*수도\\s*있을\\s*것"
      ],
      "hint": "자료의 추정 강도를 그대로 한 번만 쓴다."
    },
    "A7.hedge_boimnida": {
      "title": "\"~것으로 보입니다\"",
      "scope": "sentence",
      "regex": [
        "(것|듯)으로\\s*(보입니다|보여요|보인다|판단됩니다|예상됩니다|추정됩니다)"
      ],
      "hint": "자료가 단정했으면 단정하고, 추정했으면 누가 추정했는지 쓴다."
    },
    "A12.progressive": {
      "title": "\"~되고 있다\"",
      "scope": "sentence",
      "regex": [
        "(되|지|해지|어지|아지|워지)고\\s*있(습니다|어요|다|는|으며|고|었)"
      ],
      "hint": "변화를 수치나 시점으로 쓴다."
    },
    "A13.demonstrative_start": {
      "title": "지시어로 여는 문장",
      "scope": "sentence_start",
      "regex": [
        "^(이는|이를\\s*통해|이를\\s*위해|이러한|이런\\s*점에서|이처럼|이렇듯|이에\\s*따라|이와\\s*같이)(\\s|,)"
      ],
      "hint": "가리키는 대상을 이름으로 쓴다."
    },
    "A14.translationese": {
      "title": "번역투",
      "scope": "sentence",
      "regex": [
        "그것(은|이|을|의|에)(\\s|$)",
        "(에|에게)\\s*의(해|하여|한)(\\s|$)",
        "가장\\s*[가-힣A-Za-z]+(한|인|된|는)\\s*[가-힣A-Za-z ]{1,15}\\s*중\\s*(의\\s*)?하나",
        "중요한\\s*역할을\\s*(하|합|해|한|담당|수행)",
        "(을|를)\\s*가지고\\s*있(습니다|어요|다|는|으며)"
      ],
      "hint": "주어와 서술어를 한국어 어순으로 다시 쓴다."
    },
    "A14.doeeojida": {
      "title": "이중 피동 \"~되어지다\"",
      "scope": "sentence",
      "regex": [
        "되어지(다|는|고|며|었|게|ㄴ)|되어진"
      ],
      "hint": "\"~된다\"로 쓴다."
    },
    "INFO.we": {
      "title": "1인칭 팀 화자 \"저희\" (확인 필요)",
      "scope": "sentence",
      "regex": [
        "저희\\s*(팀|회사|조직)?(은|는|이|가|도|의)"
      ],
      "hint": "자료가 쓴 팀의 글이 아니면 자료를 주어로 쓴다(G2)."
    },
    "INFO.closing_wish": {
      "title": "마무리 인사(\"도움이 되었으면 합니다\")",
      "scope": "sentence",
      "regex": [
        "도움이\\s*(되셨|되었|됐|되었으|되길|되기를)(기를|길|으면|으리라|기\\s*바랍)?"
      ],
      "hint": "사람 블로그에도 있는 마무리 인사다. 글당 1회까지."
    },
    "A4.summary_opener": {
      "title": "결론 표지로 여는 문장(결론적으로, 요약하자면, 종합하면)",
      "scope": "sentence_start",
      "regex": [
        "^(결론적으로|요약하자면|요약하면|종합하면|종합하자면|종합해\\s*보면)"
      ],
      "hint": "표지를 지우고 결론 내용을 바로 쓴다."
    }
  }
}
